*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#f5f5f5;
    padding:40px 20px;
}

.accordion{
    max-width:700px;
    margin:auto;
}

.accordion-item{
    background:#fff;
    border-radius:10px;
    margin-bottom:16px;
    overflow:hidden;
    box-shadow:0 4px 10px rgba(0,0,0,.1);
}

summary{
    list-style:none;
    cursor:pointer;
    padding:18px 20px;
    font-weight:bold;
    background:#2563eb;
    color:#fff;
}

summary::-webkit-details-marker{
    display:none;
}

.content{
    max-height:0;
    overflow:hidden;
    transition:max-height .4s ease, padding .4s ease;
    padding:0 20px;
    background:#fff;
}

details[open] .content{
    max-height:300px;
    padding:18px 20px;
}

.content p{
    color:#555;
    line-height:1.6;
}

@media(max-width:600px){

    body{
        padding:20px;
    }

    summary{
        padding:16px;
        font-size:15px;
    }

    details[open] .content{
        max-height:400px;
    }

}