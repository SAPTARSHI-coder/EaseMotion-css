// ==========================================================================
// EaseMotion Token Fallbacks (Adjust to match your token system)
// ==========================================================================
$em-font-size-adjust-default: 0.5 !default;

/// SCSS Font Size Adjust v2 Helper Mixin
/// Normalizes aspect ratio across fallback fonts to maintain visual consistency.
///
/// @param {Number | String} $aspect-ratio - Target aspect ratio (font height / font size) or token keyword.
/// @param {String | List} $fallback-font-family - Optional fallback font stack.
///
/// @example scss
///   .heading {
///     @include em-font-size-adjust(0.52, (Helvetica, Arial, sans-serif));
///   }
@mixin em-font-size-adjust($aspect-ratio: $em-font-size-adjust-default, $fallback-font-family: null) {
  // Token integration check
  $ratio: $aspect-ratio;
  @if type-of($aspect-ratio) == 'string' and variable-exists(em-tokens) {
    $ratio: map-get($em-tokens, $aspect-ratio);
  }

  // Cross-browser vendor fallbacks
  -webkit-font-size-adjust: $ratio;
  -moz-font-size-adjust: $ratio;
  font-size-adjust: $ratio;

  @if $fallback-font-family != null {
    font-family: $fallback-font-family;
  }
}
