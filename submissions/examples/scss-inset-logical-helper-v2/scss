// ==========================================================================
// EaseMotion Helper Mixin: SCSS CSS Inset Logical Helper v2
// ==========================================================================

/// Modern logical inset positioning mixin supporting LTR/RTL internationalization,
/// cross-browser physical property fallbacks (top, right, bottom, left),
/// transition token integration, and position auto-assignment.
///
/// @param {String | List} $values [0] - Inset values (1 to 4 values mirroring shorthand syntax)
/// @param {String} $position ['absolute'] - CSS position property ('absolute' | 'relative' | 'fixed' | 'sticky')
/// @param {Boolean} $animate-inset [false] - Enables smooth inset position transitions using EaseMotion tokens
/// @param {String} $duration [var(--easemotion-duration-fast, 200ms)] - Transition speed token
/// @param {String} $timing [var(--easemotion-ease-standard, cubic-bezier(0.4, 0, 0.2, 1))] - Transition curve token
///
/// @example scss - Full Overlay Coverage
///   .overlay {
///     @include inset-logical-v2(0, absolute, true);
///   }
///
/// @example scss - Directional Shorthand (Top/Bottom 10px, Inline 20px)
///   .floating-bar {
///     @include inset-logical-v2(10px 20px, fixed);
///   }

@mixin inset-logical-v2(
  $values: 0,
  $position: 'absolute',
  $animate-inset: false,
  $duration: var(--easemotion-duration-fast, 200ms),
  $timing: var(--easemotion-ease-standard, cubic-bezier(0.4, 0, 0.2, 1))
) {
  // Unpack shorthand list (1 to 4 values) into directional variables
  $top: null;
  $right: null;
  $bottom: null;
  $left: null;

  $count: length($values);

  @if $count == 1 {
    $top: nth($values, 1);
    $right: nth($values, 1);
    $bottom: nth($values, 1);
    $left: nth($values, 1);
  } @else if $count == 2 {
    $top: nth($values, 1);
    $bottom: nth($values, 1);
    $right: nth($values, 2);
    $left: nth($values, 2);
  } @else if $count == 3 {
    $top: nth($values, 1);
    $right: nth($values, 2);
    $left: nth($values, 2);
    $bottom: nth($values, 3);
  } @else if $count == 4 {
    $top: nth($values, 1);
    $right: nth($values, 2);
    $bottom: nth($values, 3);
    $left: nth($values, 4);
  }

  // Set explicit positioning context
  @if $position != null and $position != 'none' {
    position: unquote($position);
  }

  // Legacy Physical Positioning Fallbacks for older browsers
  top: $top;
  right: $right;
  bottom: $bottom;
  left: $left;

  // Modern Logical Inset Syntax
  inset-block-start: $top;
  inset-inline-end: $right;
  inset-block-end: $bottom;
  inset-inline-start: $left;

  // Standard inset shorthand where supported
  @supports (inset: 0) {
    inset: $values;
  }

  // Optional Transition Integration using EaseMotion Tokens
  @if $animate-inset {
    will-change: top, right, bottom, left, inset;
    -webkit-transition: top $duration $timing, right $duration $timing, bottom $duration $timing, left $duration $timing, inset $duration $timing;
    -moz-transition: top $duration $timing, right $duration $timing, bottom $duration $timing, left $duration $timing, inset $duration $timing;
    -o-transition: top $duration $duration $timing, right $duration $timing, bottom $duration $timing, left $duration $timing, inset $duration $timing;
    transition: top $duration $timing, right $duration $timing, bottom $duration $timing, left $duration $timing, inset $duration $timing;
  }

  // Accessibility: Respect Reduced Motion Preferences
  @media (prefers-reduced-motion: reduce) {
    -webkit-transition: none;
    -moz-transition: none;
    -o-transition: none;
    transition: none;
  }
}
