{
  "name": "Carousel FPS Benchmark",
  "version": "1.0.0",

  "performanceBudget": {
    "fps": {
      "target": 60,
      "minimum": 55
    },

    "execution": {
      "targetMs": 50,
      "maximumMs": 100
    },

    "bundle": {
      "targetBytes": 100000,
      "maximumBytes": 150000
    }
  },

  "report": {
    "format": "json",
    "includeTimestamp": true,
    "includeSummary": true
  }
}