<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CSS Rotate-Fade Dropdown - Product Catalog</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main class="catalog-wrapper">
    <header class="catalog-header">
      <h1>Product Catalog</h1>
      <p>Filter products seamlessly using the pure CSS rotate-fade dropdown.</p>
    </header>

    <div class="filter-toolbar">
      <span class="filter-label">Sort & Filter By:</span>

      <!-- Rotate-Fade Dropdown Component -->
      <div class="dropdown-container">
        <input type="checkbox" id="dropdown-toggle" class="dropdown-checkbox">
        
        <label for="dropdown-toggle" class="dropdown-trigger" tabIndex="0">
          <span class="selected-option">Category: All Products</span>
          <span class="chevron-icon">▼</span>
        </label>

        <ul class="dropdown-menu" role="menu">
          <li class="dropdown-item" role="menuitem">
            <label for="dropdown-toggle">
              <span class="item-icon">📱</span> Electronics
            </label>
          </li>
          <li class="dropdown-item" role="menuitem">
            <label for="dropdown-toggle">
              <span class="item-icon">👕</span> Apparel & Fashion
            </label>
          </li>
          <li class="dropdown-item" role="menuitem">
            <label for="dropdown-toggle">
              <span class="item-icon">🏠</span> Home & Kitchen
            </label>
          </li>
          <li class="dropdown-item" role="menuitem">
            <label for="dropdown-toggle">
              <span class="item-icon">👟</span> Sports & Fitness
            </label>
          </li>
          <li class="dropdown-item" role="menuitem">
            <label for="dropdown-toggle">
              <span class="item-icon">📚</span> Books & Stationery
            </label>
          </li>
        </ul>

        <!-- Backdrop for closing dropdown on outside click -->
        <label for="dropdown-toggle" class="dropdown-backdrop"></label>
      </div>
    </div>

    <!-- Mock Product Grid -->
    <div class="product-grid">
      <div class="product-card">
        <div class="product-thumb">🎧</div>
        <h3>Wireless Headphones</h3>
        <p class="price">$129.99</p>
      </div>
      <div class="product-card">
        <div class="product-thumb">⌚</div>
        <h3>Smart Fitness Watch</h3>
        <p class="price">$199.99</p>
      </div>
      <div class="product-card">
        <div class="product-thumb">📷</div>
        <h3>Digital Camera</h3>
        <p class="price">$499.99</p>
      </div>
    </div>
  </main>
</body>
</html>