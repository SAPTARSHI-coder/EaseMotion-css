// ==========================================================================
// EaseMotion Helper Mixin: SCSS CSS Pointer Events Auto None v2
// ==========================================================================

/// Dynamically toggles element pointer-events interaction state with optional
/// transition feedback, visual state indicators, and cross-browser fallbacks.
/// Integrates seamlessly with EaseMotion design tokens.
///
/// @param {String} $initial-state ['none'] - Initial pointer-events state ('none' | 'auto' | 'inherit' | 'initial')
/// @param {String} $active-state ['auto'] - Target pointer-events state on state change or modifier class
/// @param {Boolean} $animate-state-change [true] - Smoothly transition opacity & filter on interaction toggle
/// @param {Number} $disabled-opacity [0.5] - Opacity representation when pointer-events is 'none'
/// @param {String} $duration [var(--easemotion-duration-fast, 200ms)] - Transition duration token
/// @param {String} $timing [var(--easemotion-ease-standard, cubic-bezier(0.4, 0, 0.2, 1))] - Transition curve token
///
/// @example scss - Basic Usage
///   .overlay-pass-through {
///     @include pointer-events-v2();
///   }
///
/// @example scss - Custom State Toggle
///   .interactive-layer {
///     @include pointer-events-v2('auto', 'none', true, 0.3);
///   }

@mixin pointer-events-v2(
  $initial-state: 'none',
  $active-state: 'auto',
  $animate-state-change: true,
  $disabled-opacity: 0.5,
  $duration: var(--easemotion-duration-fast, 200ms),
  $timing: var(--easemotion-ease-standard, cubic-bezier(0.4, 0, 0.2, 1))
) {
  // Primary Pointer Events Declaration
  pointer-events: unquote($initial-state);

  // Visual feedback when non-interactive
  @if $initial-state == 'none' {
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;

    @if $animate-state-change {
      opacity: $disabled-opacity;
      filter: alpha(opacity=#{$disabled-opacity * 100});
      will-change: opacity, pointer-events;
      -webkit-transition: opacity $duration $timing, filter $duration $timing;
      -moz-transition: opacity $duration $timing, filter $duration $timing;
      -o-transition: opacity $duration $timing, filter $duration $timing;
      transition: opacity $duration $timing, filter $duration $timing;
    }
  }

  // Active / Interactivity Modifier Trigger
  &.is-active,
  &:hover,
  &:focus-within {
    pointer-events: unquote($active-state);

    @if $initial-state == 'none' and $animate-state-change {
      opacity: 1;
      filter: alpha(opacity=100);
      user-select: auto;
      -webkit-user-select: auto;
      -moz-user-select: auto;
      -ms-user-select: auto;
    }
  }

  // Explicit Disabled State Modifier
  &.is-disabled {
    pointer-events: none !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    -moz-user-select: none !important;
    -ms-user-select: none !important;

    @if $animate-state-change {
      opacity: $disabled-opacity !important;
      filter: alpha(opacity=#{$disabled-opacity * 100}) !important;
    }
  }

  // Accessibility: Honor Reduced Motion preferences
  @media (prefers-reduced-motion: reduce) {
    -webkit-transition: none;
    -moz-transition: none;
    -o-transition: none;
    transition: none;
  }
}
